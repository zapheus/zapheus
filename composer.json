{
  "name": "zapheus/zapheus",
  "description": "An independent and framework-friendly PHP micro-framework.",
  "keywords": ["interoperable", "micro-framework", "php library", "zapheus"],
  "homepage": "https://roug.in/zapheus",
  "license": "MIT",
  "authors":
  [
    {
      "email": "rougingutib@gmail.com",
      "homepage": "https://roug.in/",
      "name": "Rougin Gutib",
      "role": "Software Engineer"
    }
  ],
  "require":
  {
    "php": ">=5.3.0"
  },
  "require-dev":
  {
    "phpunit/phpunit": "*",
    "sanmai/phpunit-legacy-adapter": "*"
  },
  "autoload":
  {
    "psr-4":
    {
      "Zapheus\\": "src"
    }
  },
  "autoload-dev":
  {
    "psr-4":
    {
      "Zapheus\\": "tests"
    }
  },
  "scripts":
  {
    "analyze": "phpstan analyse",
    "restyle": "php-cs-fixer fix --config=phpstyle.php",
    "test": "phpunit"
  }
}
